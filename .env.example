# ============================================
# DevTools Hub — Environment Configuration
# ============================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env or real credentials to version control.

# Database (PostgreSQL)
# For local Docker Compose: postgresql://postgres:postgres@localhost:5432/devtools_hub?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devtools_hub?schema=public"
# Optional direct connection URL for serverless connection poolers (e.g. Neon / Supabase)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/devtools_hub?schema=public"

# Authentication (Auth.js)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-random-32-char-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional Gemini AI Integration (Server-side only)
GEMINI_API_KEY=""
AI_DAILY_LIMIT="25"

# Optional Redis / Upstash Rate Limiting
REDIS_URL=""
REDIS_TOKEN=""

# Controlled Admin Bootstrap (used only by prisma/bootstrap-admin.ts)
ADMIN_EMAIL=""

# Optional Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
