{
  "name": "devtools-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Everything developers need. One workspace.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
