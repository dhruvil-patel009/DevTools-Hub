generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProcessingMode {
  CLIENT
  SERVER
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum AIRequestStatus {
  SUCCESS
  ERROR
  RATE_LIMITED
  QUOTA_EXCEEDED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  toolUsages    ToolUsage[]
  snippets      SavedSnippet[]
  toolSessions  SavedToolSession[]
  collections   ApiCollection[]
  aiUsages      AIUsage[]
  preference    UserPreference?
  feedbacks     Feedback[]
  auditLogs     AuditLog[]         @relation("AuditActor")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  icon        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools Tool[]

  @@index([sortOrder])
  @@index([isActive])
}

model Tool {
  id             String         @id @default(uuid()) @db.Uuid
  categoryId     String         @db.Uuid
  name           String
  slug           String         @unique
  description    String
  keywords       String[]
  icon           String
  processingMode ProcessingMode @default(CLIENT)
  isActive       Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  requiresAuth   Boolean        @default(false)
  requiresAI     Boolean        @default(false)
  seoTitle       String
  seoDescription String
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  favorites    Favorite[]
  toolUsages   ToolUsage[]
  toolSessions SavedToolSession[]
  aiUsages     AIUsage[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  toolId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
}

model ToolUsage {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  toolId     String   @db.Uuid
  success    Boolean  @default(true)
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  tool Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId])
  @@index([userId])
  @@index([createdAt])
}

model SavedSnippet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  language  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

model SavedToolSession {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  toolId          String   @db.Uuid
  title           String
  approvedPayload Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([toolId])
}

model ApiCollection {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests ApiRequest[]

  @@index([userId])
}

model ApiRequest {
  id               String   @id @default(uuid()) @db.Uuid
  collectionId     String   @db.Uuid
  name             String
  method           String
  url              String
  sanitizedHeaders Json     @default("{}")
  queryParams      Json     @default("[]")
  approvedBody     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  collection ApiCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
}

model AIUsage {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  toolId       String          @db.Uuid
  provider     String
  model        String
  inputTokens  Int?
  outputTokens Int?
  status       AIRequestStatus @default(SUCCESS)
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([toolId])
  @@index([status])
}

model UserPreference {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  theme          String   @default("dark")
  editorFontSize Int      @default(14)
  editorTabSize  Int      @default(2)
  editorWordWrap Boolean  @default(true)
  historyEnabled Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  category  String
  message   String
  status    FeedbackStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  actorId           String   @db.Uuid
  action            String
  entityType        String
  entityId          String
  sanitizedMetadata Json     @default("{}")
  createdAt         DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AppSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  message   String
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([isActive])
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  enabled     Boolean  @default(false)
  description String
  updatedAt   DateTime @updatedAt
}
